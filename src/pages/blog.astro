---
import { Image } from 'astro:assets';
import { ArrowRight, Image as ImageIcon } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import { posts } from '../data/blog';

---

<Layout
	title="Blog | IPTV News, Guides & Comparisons | NovaIPTV"
	description="Setup guides, troubleshooting walkthroughs and streaming news from the NovaIPTV team."
>
	<Header />
	<main id="main">
		<PageHeader
			eyebrow="Journal"
			title="IPTV news & "
			accent="setup guides"
			description="We are writing the first batch now. Expect practical walkthroughs rather than press releases."
		>
			<span
				class="glass mt-8 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-medium text-fg"
			>
				<span class="relative flex h-2 w-2" aria-hidden="true">
					<span
						class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
					></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
				</span>
				First articles publishing soon
			</span>
		</PageHeader>

		<section class="relative bg-bg py-20 lg:py-28">
			<div class="mx-auto max-w-7xl px-5 sm:px-8">
				{/*
					One post per row. Capped at max-w-4xl because a full-width text
					row at 1280px+ runs past a comfortable reading measure.
				*/}
				<ul class="reveal-group mx-auto max-w-4xl space-y-5">
					{
						posts.map((post) => (
							<Card as="li" class="group p-6 sm:p-7">
								<div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-7">
									{/* Fixed-ratio slot: real art when set, placeholder until then. */}
									<div class="relative aspect-video w-full shrink-0 overflow-hidden rounded-xl border border-border bg-surface-raised sm:w-44 lg:w-52">
										{post.image ? (
											<Image
												src={post.image}
												alt=""
												widths={[208, 416]}
												sizes="(min-width: 1024px) 208px, (min-width: 640px) 176px, 90vw"
												loading="lazy"
												decoding="async"
												aria-hidden="true"
												class="h-full w-full object-cover"
											/>
										) : (
											<span
												class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary/10 via-transparent to-accent/10 text-fg-subtle"
												aria-hidden="true"
											>
												<ImageIcon class="h-7 w-7" />
											</span>
										)}
									</div>

									<div class="min-w-0 grow">
										<div class="flex items-center gap-3">
											<Badge>{post.category}</Badge>
											<span class="text-xs text-fg-subtle">
												{post.readingTime}
											</span>
										</div>
										<h2 class="mt-3 text-lg font-bold text-balance text-fg sm:text-xl">
											{post.title}
										</h2>
										<p class="mt-2 text-sm leading-relaxed text-fg-muted text-pretty">
											{post.excerpt}
										</p>
									</div>
									<span class="flex shrink-0 items-center gap-2 text-sm font-semibold text-fg-subtle">
										Coming soon
										<ArrowRight
											class="h-4 w-4 transition-transform group-hover:translate-x-1"
											aria-hidden="true"
										/>
									</span>
								</div>
							</Card>
						))
					}
				</ul>

			</div>
		</section>
	</main>
	<Footer />
</Layout>
