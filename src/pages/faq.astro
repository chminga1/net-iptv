---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="FAQ | NovaIPTV"
	description="Answers on activation times, supported devices, required internet speed, simultaneous connections and refunds."
>
	<Header />
	<main id="main">
		<PageHeader
			eyebrow="Support"
			title="Questions, "
			accent="answered"
			description="Everything people ask before subscribing. If your question is not here, live chat replies in minutes."
		/>
		<Faq showHeading={false} />
	</main>
	<Footer />
</Layout>
