---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import LeaguesDevices from '../components/LeaguesDevices.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Features | NovaIPTV"
	description="4K streaming, zero buffering, 24/7 support and compatibility with every device you already own."
>
	<Header />
	<main id="main">
		<PageHeader
			eyebrow="What you get"
			title="The complete "
			accent="feature set"
			description="Built on a 20 Gbps global network with adaptive bitrate, anti-freeze technology and human support around the clock."
		/>
		<FeatureGrid showHeading={false} />
		<LeaguesDevices />
	</main>
	<Footer />
</Layout>
