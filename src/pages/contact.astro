---
import { ArrowRight, Mail, MessageCircle, MessagesSquare } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { site, whatsappUrl } from '../data/site';

const channels = [
	{
		icon: MessageCircle,
		title: 'WhatsApp',
		description: 'Fastest route to a human. Typical reply under 5 minutes.',
		detail: site.whatsappDisplay,
	},
	{
		icon: Mail,
		title: 'Email',
		description: 'For billing questions, refunds and reseller enquiries.',
		detail: site.email,
	},
	{
		icon: MessagesSquare,
		title: 'Live chat',
		description: 'Setup help while you are at the screen, with screen sharing.',
		detail: 'Mon–Sun, all hours',
	},
];

const field =
	'mt-2 min-h-11 w-full rounded-xl border border-border bg-bg px-4 py-3 text-sm text-fg placeholder:text-fg-subtle transition-colors focus:border-primary';
const label = 'block text-sm font-medium text-fg';
---

<Layout
	title="Contact Us | NovaIPTV"
	description="Talk to NovaIPTV support on WhatsApp, live chat or email. Answered 24/7, usually within minutes."
>
	<Header />
	<main id="main">
		<PageHeader
			eyebrow="Get in touch"
			title="We reply in "
			accent="minutes, not days"
			description="Pre-sales question, setup snag or billing issue — pick whichever channel suits you."
		/>

		<section class="relative bg-bg pt-10 pb-20 lg:pt-14 lg:pb-28">
			<div class="mx-auto max-w-7xl px-5 sm:px-8">
				{/*
					Fastest route to a human, so it leads the page. Horizontal from lg
					up; stacks below that.
				*/}
				<div
					class="flex flex-col gap-6 rounded-2xl border border-border bg-surface p-7 sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-10"
				>
					<div class="flex items-start gap-5">
						<span
							class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-green-600 shadow-[0_0_30px_-6px_rgb(16_185_129/0.6)]"
						>
							<MessageCircle class="h-7 w-7 text-white" aria-hidden="true" />
						</span>
						<div>
							<h2 class="text-xl font-black tracking-tight text-fg">
								Prefer WhatsApp?
							</h2>
							<p class="mt-2 max-w-xl text-sm leading-relaxed text-fg-muted">
								Message us directly and we will walk you through plans, a free
								trial or setup on your device — no forms, no ticket numbers.
							</p>
						</div>
					</div>

					<div class="shrink-0">
						<a
							href={whatsappUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-green-600 px-7 py-3.5 text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-green-500 lg:w-auto"
						>
							Chat on WhatsApp
							<ArrowRight class="h-4 w-4" aria-hidden="true" />
						</a>
						<p class="mt-3 text-center text-xs text-fg-subtle">
							{site.whatsappDisplay} · replies in under 5 minutes
						</p>
					</div>
				</div>

				<ul class="reveal-group mt-8 grid gap-6 sm:grid-cols-3 lg:mt-10">
					{
						channels.map((channel) => (
							<Card as="li" class="p-7">
								<span class="flex h-12 w-12 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-link">
									<channel.icon class="h-6 w-6" aria-hidden="true" />
								</span>
								<h2 class="mt-6 text-lg font-bold text-fg">{channel.title}</h2>
								<p class="mt-3 text-sm leading-relaxed text-fg-muted">
									{channel.description}
								</p>
								<Badge class="mt-5">{channel.detail}</Badge>
							</Card>
						))
					}
				</ul>

				<div class="mx-auto mt-16 max-w-3xl">
					<div>
						<h2 class="text-2xl font-black tracking-tight text-fg sm:text-3xl">
							Send us a message
						</h2>
						<p class="mt-3 text-sm text-fg-muted text-pretty">
							Include your order email if your question is about an existing
							subscription.
						</p>

						{/*
							Submitted with fetch to /api/contact, which relays via Resend.
							Deliberately no action/method: the endpoint speaks JSON, so a
							native form POST would render a raw 415 error page. Without
							JavaScript the <noscript> note below points at the direct
							channels instead.
						*/}
						<form id="contact-form" class="mt-8 space-y-5">
							<div class="grid gap-5 sm:grid-cols-2">
								<div>
									<label for="name" class={label}>Your name</label>
									<input
										id="name"
										name="name"
										type="text"
										required
										autocomplete="name"
										placeholder="Alex Johnson"
										class={field}
									/>
								</div>
								<div>
									<label for="email" class={label}>Email address</label>
									<input
										id="email"
										name="email"
										type="email"
										required
										autocomplete="email"
										placeholder="you@example.com"
										class={field}
									/>
								</div>
							</div>

							<div>
								<label for="subject" class={label}>Subject</label>
								<select id="subject" name="subject" class={field}>
									<option>Before I subscribe</option>
									<option>Setup help</option>
									<option>Billing or refund</option>
									<option>Reseller programme</option>
									<option>Something else</option>
								</select>
							</div>

							<div>
								<label for="message" class={label}>Message</label>
								<textarea
									id="message"
									name="message"
									rows="5"
									required
									placeholder="Tell us which device you use and what you need…"
									class={`${field} resize-y`}></textarea>
							</div>

							{/* Honeypot: off-screen and skipped by tab order, so only bots fill it. */}
							<div class="absolute left-[-9999px]" aria-hidden="true">
								<label for="company">Company</label>
								<input
									id="company"
									name="company"
									type="text"
									tabindex="-1"
									autocomplete="off"
								/>
							</div>

							<noscript>
								<p class="rounded-xl border border-border bg-surface-raised p-4 text-sm text-fg-muted">
									This form needs JavaScript. You can reach us on WhatsApp or
									at {site.email} instead.
								</p>
							</noscript>

							<div class="flex flex-col gap-4 sm:flex-row sm:items-center">
								<Button
									type="submit"
									size="lg"
									class="w-full sm:w-auto"
									data-submit
								>
									<span data-label>Send message</span>
									<svg
										data-spinner
										class="hidden h-4 w-4 animate-spin"
										viewBox="0 0 24 24"
										fill="none"
										aria-hidden="true"
									>
										<circle
											cx="12"
											cy="12"
											r="10"
											stroke="currentColor"
											stroke-width="3"
											opacity="0.25"></circle>
										<path
											d="M22 12a10 10 0 0 1-10 10"
											stroke="currentColor"
											stroke-width="3"
											stroke-linecap="round"></path>
									</svg>
								</Button>

								{/*
									aria-live so the outcome is announced, not just shown.
									Rendered empty and filled by the handler.
								*/}
								<p
									data-status
									role="status"
									aria-live="polite"
									class="text-sm"
								>
								</p>
							</div>
						</form>

						<p class="mt-8 border-t border-border pt-6 text-sm text-fg-muted">
							Looking for setup instructions instead?
							<a
								href="/devices"
								class="font-semibold text-link hover:underline"
							>
								Browse device guides &rarr;
							</a>
						</p>
					</div>

				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;

	if (form) {
		const button = form.querySelector<HTMLButtonElement>('[data-submit]');
		const label = form.querySelector<HTMLElement>('[data-label]');
		const spinner = form.querySelector<HTMLElement>('[data-spinner]');
		const status = form.querySelector<HTMLElement>('[data-status]');

		const setStatus = (message: string, tone: 'ok' | 'error' | 'none') => {
			if (!status) return;
			status.textContent = message;
			status.className =
				'text-sm ' +
				(tone === 'ok'
					? 'font-medium text-[var(--trial-text)]'
					: tone === 'error'
						? 'font-medium text-red-400'
						: 'text-fg-subtle');
		};

		const setBusy = (busy: boolean) => {
			if (button) {
				button.disabled = busy;
				button.setAttribute('aria-busy', String(busy));
			}
			spinner?.classList.toggle('hidden', !busy);
			if (label) label.textContent = busy ? 'Sending…' : 'Send message';
		};

		form.addEventListener('submit', async (event) => {
			// Only take over once we know we can: otherwise the native POST stands.
			event.preventDefault();

			// Let the browser surface its own required/type messages first.
			if (!form.reportValidity()) return;

			setBusy(true);
			setStatus('', 'none');

			const payload = Object.fromEntries(new FormData(form).entries());

			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});

				// A non-JSON body means something upstream broke; don't blow up on parse.
				const result = await response.json().catch(() => null);

				if (response.ok && result?.ok) {
					setStatus(result.message ?? 'Thanks — your message is on its way.', 'ok');
					form.reset();
				} else {
					setStatus(
						result?.error ?? 'Something went wrong. Please try again.',
						'error',
					);
				}
			} catch {
				setStatus(
					'Could not reach the server. Check your connection and try again.',
					'error',
				);
			} finally {
				setBusy(false);
			}
		});
	}
</script>
