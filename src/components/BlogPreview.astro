---
import { Image } from 'astro:assets';
import { ArrowRight, Image as ImageIcon } from '@lucide/astro';
import { HOME_POST_COUNT, posts } from '../data/blog';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
import SectionHeading from './ui/SectionHeading.astro';

// Teaser: the newest few posts. /blog holds the full list.
const featured = posts.slice(0, HOME_POST_COUNT);
---

{/*
	No top padding: this only ever follows <Faq />, which already supplies
	112px below its CTA. Keeping both would stack into a ~240px dead gap
	between two sections that share the same background.
*/}
<section class="relative bg-bg-subtle pb-20 lg:pb-28">
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<SectionHeading
			eyebrow="Journal"
			title="Guides & "
			accent="streaming news"
			description="Practical walkthroughs rather than press releases."
		/>

		<ul class="reveal-group mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				featured.map((post) => (
					<Card as="li" class="group flex h-full flex-col overflow-hidden">
						{/*
							Same fixed-ratio slot as the /blog rows: real art when set,
							placeholder until then, so adding a picture shifts nothing.
						*/}
						<div class="relative aspect-video w-full shrink-0 border-b border-border bg-surface-raised">
							{post.image ? (
								<Image
									src={post.image}
									alt=""
									widths={[400, 800]}
									sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
									loading="lazy"
									decoding="async"
									aria-hidden="true"
									class="h-full w-full object-cover"
								/>
							) : (
								<span
									class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary/10 via-transparent to-accent/10 text-fg-subtle"
									aria-hidden="true"
								>
									<ImageIcon class="h-8 w-8" />
								</span>
							)}
						</div>

						<div class="flex grow flex-col p-6">
							<div class="flex items-center gap-3">
								<Badge>{post.category}</Badge>
								<span class="text-xs text-fg-subtle">{post.readingTime}</span>
							</div>
							<h3 class="mt-4 text-lg font-bold text-balance text-fg">
								{post.title}
							</h3>
							<p class="mt-2 grow text-sm leading-relaxed text-fg-muted text-pretty">
								{post.excerpt}
							</p>
							<span class="mt-5 flex items-center gap-2 text-sm font-semibold text-fg-subtle">
								Coming soon
								<ArrowRight
									class="h-4 w-4 transition-transform group-hover:translate-x-1"
									aria-hidden="true"
								/>
							</span>
						</div>
					</Card>
				))
			}
		</ul>

		<div class="mt-12 text-center">
			<Button href="/blog" variant="secondary" class="group">
				See all
				<ArrowRight
					class="h-4 w-4 transition-transform group-hover:translate-x-1"
					aria-hidden="true"
				/>
			</Button>
		</div>
	</div>
</section>
