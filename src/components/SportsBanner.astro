---
import { Image } from 'astro:assets';
import { Trophy } from '@lucide/astro';
import sportsBg from '../assets/sports-bg.jpg';
import Button from './ui/Button.astro';
import { whatsappLink } from '../data/site';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const sports = [
	{ label: t.sports.items.basketball, caption: 'NBA · EuroLeague', glow: 'bg-orange-500/30' },
	{ label: t.sports.items.hockey, caption: 'NHL · KHL', glow: 'bg-cyan-500/30' },
	{ label: t.sports.items.baseball, caption: 'MLB · NPB', glow: 'bg-blue-500/30' },
];

---

<section
	id="sports"
	class="relative isolate overflow-clip border-y border-border bg-bg-subtle py-20 lg:py-28"
>
	{/*
		Decorative backdrop. A square source cropped into a wide band, so the
		focal point is pinned to the top where the action is. Below the fold,
		hence lazy — the hero owns the LCP.
	*/}
	<Image
		src={sportsBg}
		alt=""
		widths={[640, 960, 1280, 1600]}
		sizes="100vw"
		loading="lazy"
		decoding="async"
		aria-hidden="true"
		class="absolute inset-0 -z-10 h-full w-full object-cover object-top"
	/>

	{/*
		Scrim. From lg up the layout is two columns, so the wash is heavy on
		the left where the copy sits and lighter on the right so the collage
		reads behind the cards. Below lg the layout stacks and text crosses the
		full width, so the wash stays near-uniform or the headline would sit on
		the bright jersey.
	*/}
	<div
		class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-r from-[#0b0d12] via-[#0b0d12]/92 to-[#0b0d12]/88 lg:via-[#0b0d12]/88 lg:to-[#0b0d12]/55"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-t from-bg-subtle via-transparent to-bg-subtle/80"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute inset-0 -z-10 bg-grid opacity-40"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-7xl px-5 sm:px-8">
		<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
			<div>
				<span
					class="text-xs font-semibold tracking-[0.25em] text-accent uppercase"
				>
					{t.sports.eyebrow}
				</span>
				<h2
					class="mt-3 text-3xl font-black tracking-tight text-balance text-fg sm:text-4xl lg:text-5xl"
				>
					{t.sports.title}<span
						class="bg-gradient-to-r from-[var(--brand-500)] to-[var(--accent-500)] bg-clip-text text-transparent"
						>{t.sports.accent}</span
					>
				</h2>
				<p class="mt-4 max-w-md leading-relaxed text-fg-muted text-pretty">
					{t.sports.description}
				</p>
				<Button
					href={whatsappLink(t.sports.message)}
					external
					class="mt-8"
				>
					{t.sports.button}
				</Button>
			</div>

			<ul class="reveal-group grid grid-cols-3 gap-4">
				{
					sports.map((sport) => (
						<li class="group relative overflow-hidden rounded-card border border-border bg-surface p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/50">
							<span
								class:list={[
									'pointer-events-none absolute -top-8 left-1/2 h-24 w-24 -translate-x-1/2 rounded-full blur-2xl',
									sport.glow,
								]}
								aria-hidden="true"
							/>
							<span class="relative flex h-10 w-10 mx-auto items-center justify-center rounded-lg border border-primary/20 bg-primary/10 text-link">
								<Trophy class="h-5 w-5" aria-hidden="true" />
							</span>
							<h3 class="relative mt-4 text-sm font-bold text-fg">
								{sport.label}
							</h3>
							<p class="relative mt-1 text-xs text-fg-subtle">{sport.caption}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
