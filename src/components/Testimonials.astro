---
import { Star } from '@lucide/astro';
import Card from './ui/Card.astro';
import SectionHeading from './ui/SectionHeading.astro';
import { getLocale, useTranslations } from '../i18n';

const t = useTranslations(getLocale(Astro.currentLocale));
const reviews = t.testimonials.reviews;
---

<section class="relative bg-bg-subtle py-20 lg:py-28">
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<SectionHeading
			eyebrow={t.testimonials.eyebrow}
			title={t.testimonials.title}
			accent={t.testimonials.accent}
		/>

		<ul class="reveal-group mt-14 grid gap-6 lg:grid-cols-3">
			{
				reviews.map((review) => (
					<Card as="li" class="flex h-full flex-col p-7">
						<div class="flex gap-0.5" aria-label={t.testimonials.rating}>
							{Array.from({ length: 5 }).map(() => (
								<Star
									class="h-4 w-4 text-amber-400"
									fill="currentColor"
									aria-hidden="true"
								/>
							))}
						</div>
						<blockquote class="mt-5 grow text-sm leading-relaxed text-fg-muted">
							“{review.quote}”
						</blockquote>
						<figcaption class="mt-6 flex items-center gap-3 border-t border-border pt-5">
							<span class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-[var(--brand-500)] to-[var(--accent-500)] text-xs font-bold text-white">
								{review.initials}
							</span>
							<span>
								<span class="block text-sm font-semibold text-fg">
									{review.name}
								</span>
								<span class="block text-xs text-fg-subtle">
									{review.location}
								</span>
							</span>
						</figcaption>
					</Card>
				))
			}
		</ul>
	</div>
</section>
