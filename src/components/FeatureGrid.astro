---
import { ArrowRight, CirclePlay, Headphones, Monitor, SlidersHorizontal, Zap } from '@lucide/astro';
import { features, whatsappLink } from '../data/site';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
import SectionHeading from './ui/SectionHeading.astro';

interface Props {
	/** Dedicated pages state the title in <PageHeader>, so they pass false. */
	showHeading?: boolean;
}

const { showHeading = true } = Astro.props;


// Maps the data layer's icon key to a component, keeping site.ts framework-free.
const icons = {
	monitor: Monitor,
	zap: Zap,
	sliders: SlidersHorizontal,
	headphones: Headphones,
} as const;
---

<section
	id="features"
	class="relative overflow-clip bg-bg-subtle py-20 lg:py-28"
>
	<div
		class="pointer-events-none absolute top-0 left-1/2 h-80 w-[40rem] -translate-x-1/2 rounded-full bg-primary/10 blur-[120px]"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-7xl px-5 sm:px-8">
		{
			showHeading && (
			<SectionHeading
				eyebrow="Why it feels different"
				title="Built for people who "
				accent="hate compromise"
			/>
			)
		}

		<ul
			class:list={[
				'reveal-group grid gap-6 sm:grid-cols-2 lg:grid-cols-4',
				showHeading && 'mt-14',
			]}
		>
			{
				features.map((feature) => {
					const Icon = icons[feature.icon];
					return (
						<Card as="li" class="group relative p-7">
							<span class="flex h-12 w-12 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-link transition-all duration-300 group-hover:bg-primary/20 group-hover:text-accent">
								<Icon class="h-6 w-6" aria-hidden="true" />
							</span>
							<h3 class="mt-6 text-lg font-bold text-fg">{feature.title}</h3>
							<p class="mt-3 text-sm leading-relaxed text-fg-muted">
								{feature.description}
							</p>
							<Badge class="mt-5">{feature.badge}</Badge>
						</Card>
					);
				})
			}
		</ul>

		{/* Same closing CTA as the devices section, centred beneath the cards. */}
		<div class="mt-12 text-center">
			<Button
				href={whatsappLink("Hi! I'd like to test the Net IPTV quality myself.")}
				external
				variant="trial"
				size="lg"
				class="group"
			>
				<CirclePlay class="h-5 w-5" aria-hidden="true" />
				Test now
				<ArrowRight
					class="h-4 w-4 transition-transform group-hover:translate-x-1"
					aria-hidden="true"
				/>
			</Button>
		</div>
	</div>
</section>
