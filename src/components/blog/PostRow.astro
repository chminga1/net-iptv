---
import { Image } from 'astro:assets';
import { ArrowRight, Image as ImageIcon } from '@lucide/astro';
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import type { BlogPost } from '../../data/blog';
import { useTranslations } from '../../i18n';

/**
 * One post per row, used by /blog and the topic pages. A post with `href`
 * is a stretched link (the whole card is clickable through the title link);
 * a placeholder without one reads "Coming soon".
 */
interface Props {
	post: BlogPost;
	/** Heading level, so the row fits the page outline. */
	as?: 'h2' | 'h3';
}

const { post, as: Heading = 'h2' } = Astro.props;
const b = useTranslations(Astro.currentLocale).blog;
---

<Card as="li" class="group relative p-6 sm:p-7">
	<div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-7">
		{/* Fixed-ratio slot: real art when set, placeholder until then. */}
		<div class="relative aspect-video w-full shrink-0 overflow-hidden rounded-xl border border-border bg-surface-raised sm:w-44 lg:w-52">
			{post.image ? (
				<Image
					src={post.image}
					alt=""
					widths={[208, 416]}
					sizes="(min-width: 1024px) 208px, (min-width: 640px) 176px, 90vw"
					loading="lazy"
					decoding="async"
					aria-hidden="true"
					class="h-full w-full object-cover"
				/>
			) : (
				<span
					class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary/10 via-transparent to-accent/10 text-fg-subtle"
					aria-hidden="true"
				>
					<ImageIcon class="h-7 w-7" />
				</span>
			)}
		</div>

		<div class="min-w-0 grow">
			<div class="flex items-center gap-3">
				<Badge>{post.category}</Badge>
				<span class="text-xs text-fg-subtle">{post.readingTime}</span>
			</div>
			<Heading class="mt-3 text-lg font-bold text-balance text-fg sm:text-xl">
				{
					post.href ? (
						<a href={post.href} class="after:absolute after:inset-0 after:rounded-card">
							{post.title}
						</a>
					) : (
						post.title
					)
				}
			</Heading>
			<p class="mt-2 text-sm leading-relaxed text-fg-muted text-pretty">
				{post.excerpt}
			</p>
		</div>
		<span
			class:list={[
				'flex shrink-0 items-center gap-2 text-sm font-semibold',
				post.href ? 'text-link' : 'text-fg-subtle',
			]}
		>
			{post.href ? b.readGuide : b.comingSoon}
			<ArrowRight
				class="h-4 w-4 transition-transform group-hover:translate-x-1"
				aria-hidden="true"
			/>
		</span>
	</div>
</Card>
