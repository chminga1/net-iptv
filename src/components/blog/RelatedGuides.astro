---
import { ArrowRight } from '@lucide/astro';
import Card from '../ui/Card.astro';
import { getCluster, postUrl, topicUrl, type Post, type RelatedGuides } from '../../lib/blog';
import { getLocale, useTranslations } from '../../i18n';

/**
 * Automatic cluster navigation under every article: pillar → hub → siblings
 * (or, on the pillar, every cluster hub). It keeps the pillar/cluster graph
 * connected even before writers add contextual links, and is not counted
 * against the in-body link budget.
 */
interface Props {
	post: Post;
	related: RelatedGuides;
}

const { post, related } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const r = useTranslations(locale).blog.related;
const cluster = getCluster(post.data.cluster, locale);

const items: { label: string; post: Post }[] = [
	...(related.pillar ? [{ label: r.startHere, post: related.pillar }] : []),
	...(related.hub ? [{ label: r.clusterGuide(cluster.name), post: related.hub }] : []),
	...related.hubs.map((hub) => ({ label: getCluster(hub.data.cluster, locale).name, post: hub })),
	...related.siblings.map((sibling) => ({ label: cluster.name, post: sibling })),
];

const heading =
	post.data.role === 'pillar'
		? r.exploreAll
		: post.data.role === 'hub'
			? r.everyGuideIn(cluster.name)
			: r.relatedGuides;
---

{
	items.length > 0 && (
		<section aria-labelledby="related-heading" class="mt-16 border-t border-border pt-12">
			<div class="flex flex-wrap items-baseline justify-between gap-3">
				<h2 id="related-heading" class="text-2xl font-bold tracking-tight text-fg">
					{heading}
				</h2>
				<a href={topicUrl(cluster.id, locale)} class="text-sm font-semibold text-link hover:underline">
					{r.allArticles(cluster.name)}
				</a>
			</div>
			<ul class="mt-6 grid gap-4 sm:grid-cols-2">
				{items.map((item) => (
					<Card as="li" class="group relative p-5">
						<span class="text-xs font-semibold tracking-wide text-accent uppercase">
							{item.label}
						</span>
						<p class="mt-2 font-semibold text-balance text-fg">
							<a href={postUrl(item.post.id, locale)} class="after:absolute after:inset-0 after:rounded-card">
								{item.post.data.title}
							</a>
						</p>
						<ArrowRight
							class="mt-3 h-4 w-4 text-fg-subtle transition-transform group-hover:translate-x-1"
							aria-hidden="true"
						/>
					</Card>
				))}
			</ul>
		</section>
	)
}
