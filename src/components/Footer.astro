---
import { Play } from '@lucide/astro';
import { site } from '../data/site';

interface Column {
	readonly title: string;
	readonly links: readonly { label: string; href: string }[];
}

// `/#movies` deep-links into a section of the landing page from any route.
const columns: readonly Column[] = [
	{
		title: 'Product',
		links: [
			{ label: 'Live TV', href: '/features' },
			{ label: 'Movies & VOD', href: '/#movies' },
			{ label: 'Sports', href: '/#sports' },
			{ label: 'Devices', href: '/devices' },
			{ label: 'Pricing', href: '/pricing' },
		],
	},
	{
		title: 'Support',
		links: [
			{ label: 'Setup guides', href: '/devices' },
			{ label: 'Live chat', href: '/contact' },
			{ label: 'FAQ', href: '/faq' },
			{ label: 'Refund policy', href: '/terms#refunds' },
			{ label: 'Contact us', href: '/contact' },
		],
	},
	{
		title: 'Company',
		links: [
			{ label: 'Blog', href: '/blog' },
			{ label: 'Reseller program', href: '/contact' },
			{ label: 'Terms of service', href: '/terms' },
			{ label: 'Privacy policy', href: '/privacy' },
		],
	},
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-subtle py-14">
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<div class="grid gap-10 md:grid-cols-4">
			<div>
				<a href="/" class="flex items-center gap-2.5">
					<span
						class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-[var(--brand-500)] to-[var(--accent-500)]"
					>
						<Play
							class="h-4 w-4 text-white"
							fill="currentColor"
							aria-hidden="true"
						/>
					</span>
					<span class="text-base font-bold tracking-tight text-fg">
						Nova<span class="text-link">IPTV</span>
					</span>
				</a>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-fg-subtle">
					Premium IPTV streaming — {site.channels} live channels and {
						site.titles
					} titles in up to 4K, on every device you own.
				</p>
			</div>

			{
				columns.map((column) => (
					<div>
						<h2 class="text-sm font-semibold text-fg">{column.title}</h2>
						<ul class="mt-4 space-y-2.5">
							{column.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-sm text-fg-subtle transition-colors hover:text-link"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div
			class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 sm:flex-row"
		>
			<p class="text-sm text-fg-subtle">
				&copy; {year} {site.name}. All rights reserved.
			</p>
			<p class="text-xs text-fg-subtle">
				Streaming service. Content availability varies by region.
			</p>
		</div>
	</div>
</footer>
