---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import LeaguesDevices from '../components/LeaguesDevices.astro';
import Footer from '../components/Footer.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { getLocale, localizePath, useTranslations } from '../i18n';


const locale = getLocale(Astro.currentLocale);
const page = useTranslations(locale).pages.devices;
const setups = page.setups;
---

<Layout title={page.title} description={page.description}>
	<Header />
	<main id="main">
		<PageHeader
			eyebrow={page.eyebrow}
			title={page.heading}
			accent={page.accent}
			description={page.intro}
		/>

		<LeaguesDevices />

		<section class="relative overflow-clip bg-bg-subtle py-20 lg:py-28">
			<div
				class="pointer-events-none absolute top-0 left-1/2 h-80 w-[40rem] -translate-x-1/2 rounded-full bg-primary/10 blur-[120px]"
				aria-hidden="true"
			>
			</div>

			<div class="relative mx-auto max-w-7xl px-5 sm:px-8">
				<SectionHeading
					eyebrow={page.guidesEyebrow}
					title={page.guidesTitle}
					accent={page.guidesAccent}
					description={page.guidesDescription}
				/>

				<ul class="reveal-group mt-14 grid gap-6 lg:grid-cols-2">
					{
						setups.map((setup) => (
							<Card as="li" class="p-7">
								<div class="flex items-center justify-between gap-4">
									<h3 class="text-lg font-bold text-fg">{setup.platform}</h3>
									<Badge class="shrink-0">{setup.time}</Badge>
								</div>
								<ol class="mt-6 space-y-4">
									{setup.steps.map((step, index) => (
										<li class="flex items-start gap-4">
											<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-primary/30 bg-primary/10 text-xs font-black text-link">
												{index + 1}
											</span>
											<p class="text-sm leading-relaxed text-fg-muted">{step}</p>
										</li>
									))}
								</ol>
							</Card>
						))
					}
				</ul>

				<div class="mt-14 text-center">
					<Button href={localizePath('/contact', locale)} variant="secondary">
						{page.needHand}
					</Button>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
