# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Where contact form submissions are delivered.
TO_EMAIL=your_recipient_email@example.com

# Sender address. Must be on a domain you have verified in Resend.
# Leave unset to use Resend's shared test sender, which only delivers to the
# address that owns the Resend account.
FROM_EMAIL=NovaIPTV <onboarding@resend.dev>
